# Copy to .env on the server:  cp .env.example .env   then edit.

# REQUIRED -- signs login tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# Port users open in the browser (http://<server-ip>:<HTTP_PORT>)
HTTP_PORT=80

# Largest upload accepted (MB); nginx allows up to 60
MAX_UPLOAD_MB=50

# Optional -- e-mail notifications to checkers (leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
